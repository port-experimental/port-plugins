      "priority": {
        "type": "string",
        "title": "Priority",
        "enum": ["Low", "Medium", "High", "Critical"],
        "enumColors": {
          "Low": "lightGray",
          "Medium": "blue",
          "High": "orange",
          "Critical": "red"
        }
      }
